
# === Database Configuration ===
MONGODB_URI=


# === Data Source APIs ===
# Optional — free tier available, used for future on-chain/macro feature slots (docs/06-data-and-features.md)
COINGECKO_API_KEY=

# Optional — paid tier, used for future extended historical/derivatives data
CRYPTOCOMPARE_API_KEY=

# Economic calendar. The primary source is ForexFactory's public weekly JSON, which
# needs NO key and no quota. This FCS key is only a fallback for when that feed is
# unreachable; its free tier allows 500 calls a MONTH, so leaving it blank is fine.
# Get one at https://fcsapi.com/ if you want the fallback.
ECONOMIC_CALENDAR_API_KEY=

# News headlines: comma-separated `Name|url` RSS feeds. Blank uses the built-in mix
# of crypto and macro outlets (CoinDesk, Cointelegraph, Bitcoin.com, ForexLive,
# FXStreet, Decrypt, Yahoo Finance) — macro is included because BTC/ETH trade
# risk-on/off alongside everything else.
NEWS_FEEDS=
NEWS_ENABLED=true
# Skip opening NEW trades within this many minutes of a High-impact release (0 disables).
NEWS_BLACKOUT_MIN=15
NEWS_REFRESH_SEC=180
# The calendar publishes a week at a time and its host rate-limits hard, so it gets
# a much slower clock than headlines.
NEWS_CALENDAR_REFRESH_SEC=1800

# === Exchange Integration ===
# Delta Exchange Testnet (for paper trading) - Get testnet API keys at: https://testnet.delta.exchange/
DELTA_EXCHANGE_API_KEY=
DELTA_EXCHANGE_API_SECRET=

# === AI/LLM Providers ===
# OpenAI API Key - Get at: https://platform.openai.com/api-keys
OPENAI_API_KEY=

# Anthropic API Key - Get at: https://console.anthropic.com/
ANTHROPIC_API_KEY=

# Gemini API Key - Get at: https://aistudio.google.com/
GEMINI_API_KEY=

# === Agent Configuration ===
# Set to 'true' to enable AI agents (requires API keys above)
AGENTS_ENABLED=true

# India testnet host (matches the region your API key was issued in)
DELTA_EXCHANGE_BASE_URL=https://cdn-ind.testnet.deltaex.org

# Frontend container talks to the backend running on the host
VITE_API_PROXY=http://host.docker.internal:4000

# Mirror every opened trade onto Delta (testnet host configured above).
# This is read once at boot, so a change needs a backend restart. While it is false
# the engine still runs and records trades — they are simulated, and the dashboard
# banner says so rather than leaving you to wonder why the exchange is empty.
LIVE_TRADING=false

# How the opening order reaches Delta.
#   limit  (default) rests at the mark and earns the cheaper maker fee, but an order
#          that has not filled within LIMIT_ORDER_TIMEOUT_MS is cancelled and the
#          trade is marked REJECTED — a common reason for "live is on, but nothing
#          is on the exchange" in a fast market.
#   market crosses the spread so it effectively always fills, paying the taker fee
#          plus some slippage.
DELTA_ENTRY_ORDER_TYPE=limit
LIMIT_ORDER_TIMEOUT_MS=120000

ENGINE_INSTANCE_ID=local
ENGINE_LEADER_ID=domain
# Obsolete: the ledger now MERGES the local JSON file with MongoDB rather than letting
# either replace the other, so nothing needs migrating and no trade is ever dropped.
LEDGER_MIGRATE_LOCAL_FILE=false

# === Delta India charges and tax (used for net P&L and the tax panel) ===
# FALLBACKS ONLY. At boot the backend reads the real maker/taker commission for your
# account's fee tier from Delta's /v2/products, and a filled order's own reported
# commission overrides even that. These apply only if Delta is unreachable.
DELTA_TAKER_FEE_RATE=0.0005
DELTA_MAKER_FEE_RATE=0.0002
# GST is charged on the trading FEE, not on notional or profit.
INDIA_GST_RATE=0.18
# TDS u/s 194S. Left at 0: 194S targets the transfer of a virtual digital asset, and
# cash-settled futures are generally outside it. Set 0.01 if your CA says otherwise.
INDIA_TDS_RATE=0
# s.115BBH: 30% on VDA gains plus a 4% cess = 31.2% effective. Losses cannot be set
# off against gains, so the tax panel bases the provision on winning trades alone.
INDIA_VDA_TAX_RATE=0.30
INDIA_CESS_RATE=0.04
# FALLBACK ONLY, and only used to show an INR figure beside a USD-settled trade.
# The live rate is fetched twice a day from open.er-api.com (frankfurter.app as
# backup), both free and keyless. This value applies only until the first fetch
# lands, or if every source is unreachable.
USD_INR_RATE=88

