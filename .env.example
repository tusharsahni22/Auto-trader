# Starting paper-trading equity (USD)
STARTING_EQUITY=10000

# === Database Configuration ===
# MongoDB Atlas (Recommended - Free tier available at mongodb.com/cloud/atlas)
# Replace <username>, <password>, and <cluster-url> with your Atlas credentials
MONGODB_URI=mongodb+srv://<username>:<password>@<cluster-url>/autotrader?retryWrites=true&w=majority

# === Data Source APIs ===
# Optional — free tier available, used for future on-chain/macro feature slots (docs/06-data-and-features.md)
COINGECKO_API_KEY=

# Optional — adds CryptoCompare headlines to the news feed. Without it the feed
# still works: crypto news comes from public RSS (CoinDesk, Cointelegraph, Bitcoin.com).
# Note CryptoCompare's news endpoint now returns 401 unless a key is supplied.
CRYPTOCOMPARE_API_KEY=

# Economic Calendar API (FCS API recommended) - Get free key at: https://fcsapi.com/
ECONOMIC_CALENDAR_API_KEY=

# === Market News & Economic Calendar ===
# Headlines come from public crypto RSS (no key needed); the calendar table uses
# the FCS economy endpoint and needs ECONOMIC_CALENDAR_API_KEY above.
NEWS_ENABLED=true
# Skip opening NEW trades within N minutes either side of a High-impact event
# (0 disables). Applies to the signal bot only — open positions keep being
# managed by their stops and targets, and the archetype engine is unaffected.
NEWS_BLACKOUT_MIN=15
# Which currencies count as High-impact for the blackout. Empty means all.
NEWS_CURRENCIES=USD,EUR,GBP,JPY,CNY
# How often to re-fetch RSS headlines (seconds, min 60). Free, no quota.
NEWS_REFRESH_SEC=180
# How often to re-fetch the economic calendar (seconds, min 600). This API is
# metered — the free FCS tier allows 500 calls/month, so polling it at the
# headline rate exhausts the quota in about a day. 6h = ~120 calls/month.
NEWS_CALENDAR_REFRESH_SEC=21600

# === Exchange Integration ===
# Delta Exchange Testnet (for paper trading) - Get testnet API keys at: https://testnet.delta.exchange/
# When these are set the engine uses the live wallet balance as its equity. If the
# call fails, equity falls back to STARTING_EQUITY and /api/balance reports
# source:"simulated" with the error — it never presents a simulated number as real.
DELTA_EXCHANGE_API_KEY=
DELTA_EXCHANGE_API_SECRET=
# Keys are environment-specific. Testnet keys only work against the testnet host.
# https://testnet-api.delta.exchange (default, global testnet)
# https://cdn-ind.testnet.deltaex.org (India testnet)
# https://api.delta.exchange (global live) · https://api.india.delta.exchange (India live)
DELTA_EXCHANGE_BASE_URL=

# Send real orders to Delta for every trade the system opens (engine, bot and
# manual entry alike). When false everything stays a local paper simulation and
# trades are labelled SIMULATED in the UI. Point DELTA_EXCHANGE_BASE_URL at a
# testnet host before enabling this.
LIVE_TRADING=false

# === AI/LLM Providers ===
# OpenAI API Key - Get at: https://platform.openai.com/api-keys
OPENAI_API_KEY=

# Anthropic API Key - Get at: https://console.anthropic.com/
ANTHROPIC_API_KEY=

# === Agent Configuration ===
# Set to 'true' to enable AI agents (requires API keys above)
AGENTS_ENABLED=false
