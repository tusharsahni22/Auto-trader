# Docker Hub image repository
DOCKERHUB_IMAGE=tusharsahni22/auto-trader

# Use backend-latest/frontend-latest, or pin a timestamped release, for example:
# BACKEND_TAG=backend-20260918-143025
# FRONTEND_TAG=frontend-20260918-143025
BACKEND_TAG=backend-latest
FRONTEND_TAG=frontend-latest

BACKEND_PORT=4000
FRONTEND_PORT=5173

# The cloud/domain instance is the sole trading leader. Local should use local.
ENGINE_INSTANCE_ID=domain
ENGINE_LEADER_ID=domain
# Set true only for the first domain deployment to import its existing trader.json.
LEDGER_MIGRATE_LOCAL_FILE=false

STARTING_EQUITY=10000
MONGODB_URI=

# Keep false unless you intentionally want real Delta orders. Read once at boot,
# so a change needs a container restart. While false the engine still runs and
# records trades; they are simulated and the dashboard banner says so.
LIVE_TRADING=false
DELTA_EXCHANGE_API_KEY=
DELTA_EXCHANGE_API_SECRET=
DELTA_EXCHANGE_BASE_URL=
DELTA_EXECUTION_MAX_RETRIES=5
# limit  = rests at the mark, cheaper maker fee, but an entry that has not filled
#          within LIMIT_ORDER_TIMEOUT_MS is cancelled and the trade marked REJECTED.
# market = crosses the spread so it effectively always fills, paying taker + slippage.
DELTA_ENTRY_ORDER_TYPE=limit
LIMIT_ORDER_TIMEOUT_MS=120000
AUTO_START_ENGINE=true

COINGECKO_API_KEY=
CRYPTOCOMPARE_API_KEY=
# Optional. The economic calendar's primary source is ForexFactory's free weekly
# feed, which needs no key; this FCS key is only a fallback and its free tier is
# capped at 500 calls a MONTH. Leaving it blank is fine.
ECONOMIC_CALENDAR_API_KEY=
NEWS_ENABLED=true
NEWS_BLACKOUT_MIN=15
NEWS_CURRENCIES=USD,EUR,GBP,JPY,CNY
NEWS_REFRESH_SEC=180
NEWS_CALENDAR_REFRESH_SEC=1800
# Comma-separated `Name|url` RSS feeds. Blank uses the built-in crypto + macro mix.
NEWS_FEEDS=

# === Delta India charges and Indian tax (net P&L and the tax panel) ===
# Fee rates are FALLBACKS: the backend reads your account's real commission tier
# from Delta at boot, and a filled order's reported commission wins over both.
DELTA_TAKER_FEE_RATE=0.0005
DELTA_MAKER_FEE_RATE=0.0002
# GST applies to the trading FEE, not to notional or profit.
INDIA_GST_RATE=0.18
# TDS u/s 194S. 0 by default: 194S targets transfers of a virtual digital asset and
# cash-settled futures are generally outside it. Set 0.01 if your CA says otherwise.
INDIA_TDS_RATE=0
# s.115BBH: 30% on gains + 4% cess = 31.2%. Losses cannot be set off against gains.
INDIA_VDA_TAX_RATE=0.30
INDIA_CESS_RATE=0.04
# Fallback only — USD/INR is fetched live twice a day from a free keyless feed.
USD_INR_RATE=88

OPENAI_API_KEY=
ANTHROPIC_API_KEY=
AGENTS_ENABLED=false