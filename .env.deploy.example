# Docker Hub image repository
DOCKERHUB_IMAGE=tusharsahni22/auto-trader

# Use backend-latest/frontend-latest, or pin a timestamped release, for example:
# BACKEND_TAG=backend-20260918-143025
# FRONTEND_TAG=frontend-20260918-143025
BACKEND_TAG=backend-latest
FRONTEND_TAG=frontend-latest

BACKEND_PORT=4000
FRONTEND_PORT=5173

# The cloud/domain instance is the sole trading leader. Local should use local.
ENGINE_INSTANCE_ID=domain
ENGINE_LEADER_ID=domain
# Set true only for the first domain deployment to import its existing trader.json.
LEDGER_MIGRATE_LOCAL_FILE=false

STARTING_EQUITY=10000
MONGODB_URI=

# Keep false unless you intentionally want real Delta orders.
LIVE_TRADING=false
DELTA_EXCHANGE_API_KEY=
DELTA_EXCHANGE_API_SECRET=
DELTA_EXCHANGE_BASE_URL=
DELTA_EXECUTION_MAX_RETRIES=5

COINGECKO_API_KEY=
CRYPTOCOMPARE_API_KEY=
ECONOMIC_CALENDAR_API_KEY=
NEWS_ENABLED=true
NEWS_BLACKOUT_MIN=15
NEWS_CURRENCIES=USD,EUR,GBP,JPY,CNY
NEWS_REFRESH_SEC=180
NEWS_CALENDAR_REFRESH_SEC=21600

OPENAI_API_KEY=
ANTHROPIC_API_KEY=
AGENTS_ENABLED=false