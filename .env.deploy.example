# Cloud/server deploy config. Copy to `.env` next to docker-compose.yml.
#
# Every key here has a working default in code, so the stack starts even with an
# empty file. What follows is ordered by how likely you are to need it.
#
# docker-compose.yml passes this whole file into the container, so adding a key
# here is all that is ever needed — the compose file does not have to change.

# ─── Images ──────────────────────────────────────────────────────────────────
DOCKERHUB_IMAGE=tusharsahni22/auto-trader
# Or pin a release, e.g. BACKEND_TAG=backend-20260918-143025
BACKEND_TAG=backend-latest
FRONTEND_TAG=frontend-latest
BACKEND_PORT=4000
FRONTEND_PORT=5173

# ─── Exchange ────────────────────────────────────────────────────────────────
# Region-specific: a key issued on the India testnet is rejected by every other host.
DELTA_EXCHANGE_BASE_URL=https://cdn-ind.testnet.deltaex.org
DELTA_EXCHANGE_API_KEY=
DELTA_EXCHANGE_API_SECRET=

# Read once at boot, so changing it needs a container restart. While false the
# engine still runs and records trades — they are simulated, and the dashboard
# banner says so rather than leaving the exchange looking mysteriously empty.
LIVE_TRADING=false

# limit  = rests at the mark for the cheaper maker fee, but an entry that has not
#          filled within LIMIT_ORDER_TIMEOUT_MS is cancelled and marked REJECTED.
#          That is the usual cause of "live is on but nothing reached the exchange".
# market = crosses the spread so it effectively always fills, paying taker + slippage.
DELTA_ENTRY_ORDER_TYPE=limit

# ─── Shared state ────────────────────────────────────────────────────────────
# Trades are held in a local JSON file and mirrored to MongoDB; the two are merged
# on every read, so neither can delete the other's rows. Leave blank for file-only.
MONGODB_URI=

# Only the leader runs the strategy against the shared account. A second instance
# with a different ENGINE_INSTANCE_ID serves the dashboard read-only.
ENGINE_INSTANCE_ID=domain
ENGINE_LEADER_ID=domain

STARTING_EQUITY=10000

# ─── Optional ────────────────────────────────────────────────────────────────
# The engine starts automatically on boot. Set false to require a manual Start.
#AUTO_START_ENGINE=true

# Skip opening NEW trades within N minutes of a High-impact release (0 disables).
#NEWS_BLACKOUT_MIN=15

# The economic calendar uses ForexFactory's free keyless feed. This FCS key is only
# a fallback and its free tier is capped at 500 calls a MONTH — usually leave blank.
#ECONOMIC_CALENDAR_API_KEY=

# TDS u/s 194S. 0 because 194S targets transfers of a virtual digital asset and
# cash-settled futures are generally outside it. Set 0.01 if your CA disagrees.
#INDIA_TDS_RATE=0

# GST, the s.115BBH rate and the cess are statutory and change only in a Union
# Budget. Override only if the law changes.
#INDIA_GST_RATE=0.18
#INDIA_VDA_TAX_RATE=0.30
#INDIA_CESS_RATE=0.04

# Delta's real commission for your fee tier is read from the exchange at boot, and
# USD/INR is fetched twice a day from a free feed. These override the fallbacks
# used only when those sources are unreachable.
#DELTA_TAKER_FEE_RATE=0.0005
#DELTA_MAKER_FEE_RATE=0.0002
#USD_INR_RATE=88

# LLM agents are off by default and cost provider tokens when enabled.
#AGENTS_ENABLED=false
#ANTHROPIC_API_KEY=
#OPENAI_API_KEY=
